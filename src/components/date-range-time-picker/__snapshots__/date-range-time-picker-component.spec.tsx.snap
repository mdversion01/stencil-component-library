<date-range-time-picker-component input-id="aria-range-time" label="Maintenance Window" required="" value="">
  <div class="date-picker">
    <div class="dropdown-wrapper">
      <div class="form-group form-input-group-basic">
        <label class="form-control-label required" for="aria-range-time" id="snapshot-id-1">
          <span class="required">
            Maintenance Window
          </span>
          <span class="required">
            *
          </span>
        </label>
        <div>
          <div aria-label="Date and time picker group" class="input-group" role="group">
            <div class="drp-input-field">
              <input aria-describedby="snapshot-id-4" aria-labelledby="snapshot-id-1" aria-required="true" autocomplete="off" class="form-control" id="aria-range-time" placeholder="YYYY-MM-DD HH:MM - YYYY-MM-DD HH:MM" type="text" value="">
            </div>
            <div class="input-group-append">
              <button aria-controls="snapshot-id-2" aria-expanded="false" aria-haspopup="dialog" aria-label="Toggle calendar picker" class="btn calendar-button input-group-text" type="button">
                <i aria-hidden="true" class="fa-calendar-alt fas"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="dropdown" id="snapshot-id-2">
        <div aria-describedby="snapshot-id-4" aria-labelledby="snapshot-id-3" aria-modal="true" class="dropdown-content" role="dialog" tabindex="-1">
          <div class="sr-only visually-hidden" id="snapshot-id-3">
            Maintenance Window
          </div>
          <div class="sr-only visually-hidden" id="snapshot-id-4">
            Select a start date and end date. Use arrow keys to navigate days. Press Enter to select. Enter times in HH:MM.
          </div>
          <div class="date-picker">
            <div class="range-picker-wrapper">
              <div aria-label="Navigation controls" class="mb-1 range-picker-nav">
                <button aria-label="Previous month" class="dp-btn-outline-secondary range-picker-nav-btn" type="button">
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 320 512" xmlns="http://www.w3.org/2000/svg">
                    <path d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c-12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"></path>
                  </svg>
                </button>
                <div class="selectors">
                  <label class="sr-only visually-hidden" for="snapshot-id-6" id="snapshot-id-5">
                    Select month
                  </label>
                  <select aria-labelledby="snapshot-id-5" class="form-control form-select months select-sm" id="snapshot-id-6">
                    <option value="0">
