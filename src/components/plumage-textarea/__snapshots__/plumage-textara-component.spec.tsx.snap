exports[`plumage-textarea-component renders default markup: default-markup 1`] = `
<plumage-textarea-component label="Comments">
  <div class="stencil-component">
    <div>
      <div class="form-group">
        <label class="form-control-label label-sm" for="plumage-ta-test" id="plumage-ta-test-label">
          <span>
            Comments
          </span>
        </label>
        <div>
          <div class="input-container" role="presentation">
            <div class="sr-only" id="plumage-ta-test-help">
              Enter Comments. This is a multiline text area.
            </div>
            <div aria-hidden="true" class="b-underline b-underline-top" role="presentation">
              <div aria-hidden="true" class="b-focus b-focus-top" role="presentation" style="width: 0; left: 50%;"></div>
            </div><textarea aria-describedby="plumage-ta-test-help" aria-invalid="false" aria-labelledby="plumage-ta-test-label" autocomplete="off" class="textarea-control" id="plumage-ta-test" name="plumage-ta-test" placeholder="Comments" rows="3" spellcheck="" value=""></textarea>
            <div aria-hidden="true" class="b-underline b-underline-bottom" role="presentation">
              <div aria-hidden="true" class="b-focus b-focus-bottom" role="presentation" style="width: 0; left: 50%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</plumage-textarea-component>
`;

