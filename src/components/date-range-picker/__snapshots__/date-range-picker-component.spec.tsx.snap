                        -
                      </span>
                      <span class="end-date">
                        N/A
                      </span>
                    </span>
                  </div>
                </div>
              </div>
              <div class="ok-button">
                <button aria-label="Confirm or close date picker" class="btn dp-btn-primary" type="button">
                  Close
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</date-range-picker-component>
`;

