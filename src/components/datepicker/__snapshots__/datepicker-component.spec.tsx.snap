              <input aria-describedby="datepicker-test-id__desc datepicker-test-id__validation" aria-invalid="true" aria-labelledby="datepicker-test-id__label" class="form-control is-invalid" id="datepicker-test-id" placeholder="YYYY-MM-DD" required="" type="text" value="1899-12-31">
              <button aria-label="Clear Field" class="clear-input-button" role="button" type="button">
