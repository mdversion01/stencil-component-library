exports[`datepicker-component preserves the last valid selection for an impossible MM-DD-YYYY controlled value: invalid-controlled-mdy-preserves-selection 1`] = `
<datepicker-component append="" append-id="" current-month="1" current-year="2026" date-format="MM-DD-YYYY" form-layout="" icon="fas fa-calendar-alt" input-id="controlled-datepicker-invalid" label="Date Picker" placeholder="MM-DD-YYYY" prepend-id="" required="" size="" validation-message="" value="02-30-2026" warning-message="">
