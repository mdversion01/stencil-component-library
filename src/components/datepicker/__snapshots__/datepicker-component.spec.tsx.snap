<datepicker-component append="" append-id="" current-month="8" current-year="2026" date-format="YYYY-MM-DD" form-layout="" icon="fas fa-calendar-alt" input-id="datepicker-test-id" label="Date Picker" placeholder="YYYY-MM-DD" plumage="" prepend-id="" size="" validation-message="" value="" warning-message="">
  <div class="plumage">
    <div class="date-picker">
      <div class="dropdown-wrapper">
        <div>
