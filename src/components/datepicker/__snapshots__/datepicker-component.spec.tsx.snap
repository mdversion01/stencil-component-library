exports[`datepicker-component inline layout does not apply numeric grid classes by default: inline-layout 1`] = `
<datepicker-component append="" append-id="" current-month="8" current-year="2026" date-format="YYYY-MM-DD" form-layout="inline" icon="fas fa-calendar-alt" input-col="6" input-id="datepicker-test-id" label="Date" placeholder="YYYY-MM-DD" prepend-id="" size="" validation-message="" value="" warning-message="">
  <div class="date-picker">
    <div class="dropdown-wrapper">
      <div class="form-group form-input-group-basic inline row">
        <label aria-hidden="true" class="form-control-label" for="datepicker-test-id" id="datepicker-test-id__label">
          <span>
            Date:
          </span>
        </label>
        <div>
          <div class="sr-only" id="datepicker-test-id__desc">
