exports[`datepicker-component validates a non-empty value with an invalid year when validation is enabled: invalid-year 1`] = `
<datepicker-component append="" append-id="" current-month="11" current-year="1899" date-format="YYYY-MM-DD" form-layout="" icon="fas fa-calendar-alt" input-id="datepicker-test-id" label="Date Picker" placeholder="YYYY-MM-DD" prepend-id="" required="" size="" validation="" validation-message="Year is required, must be 4 digits, and must be greater than or equal to 1900." value="1899-12-31" warning-message="">
  <div class="date-picker">
    <div class="dropdown-wrapper">
