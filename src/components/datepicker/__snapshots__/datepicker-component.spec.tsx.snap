                <div class="drp-input-field">
                  <input aria-describedby="datepicker-test-id__desc" aria-labelledby="datepicker-test-id__label" class="form-control" id="datepicker-test-id" name="selectedDate" placeholder="YYYY-MM-DD" type="text" value="">
                </div>
                <button aria-controls="datepicker-test-id__dialog" aria-expanded="false" aria-haspopup="dialog" aria-label="Toggle Calendar Picker" class="btn calendar-button input-group-text" type="button">
                  <i aria-hidden="true" class="fa-calendar-alt fas"></i>
                </button>
