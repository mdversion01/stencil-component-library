exports[`datepicker-component accepts 2028-02-29 because 2028 is a leap year: leap-year-valid-controlled-value 1`] = `
<datepicker-component append="" append-id="" current-month="1" current-year="2028" date-format="YYYY-MM-DD" form-layout="" icon="fas fa-calendar-alt" input-id="controlled-datepicker-leap-year" label="Date Picker" placeholder="YYYY-MM-DD" prepend-id="" required="" size="" validation-message="" value="2028-02-29" warning-message="">
  <div class="date-picker">
    <div class="dropdown-wrapper">
      <div class="form-group form-input-group-basic">
        <label aria-hidden="true" class="form-control-label" for="controlled-datepicker-leap-year" id="controlled-datepicker-leap-year__label">
          <span>
            Date Picker
          </span>
          <span class="required">
            *
          </span>
        </label>
        <div>
          <div class="sr-only" id="controlled-datepicker-leap-year__desc">
            Enter a date in YYYY-MM-DD format. Use the calendar button to pick a date.
          </div>
          <div aria-label="Date Picker Group" class="input-group" role="group">
            <div class="drp-input-field">
              <input aria-describedby="controlled-datepicker-leap-year__desc" aria-labelledby="controlled-datepicker-leap-year__label" class="form-control" id="controlled-datepicker-leap-year" placeholder="YYYY-MM-DD" required="" type="text" value="2028-02-29">
              <button aria-label="Clear Field" class="clear-input-button" role="button" type="button">
                <i aria-hidden="true" class="fa-times-circle fas"></i>
              </button>
            </div>
            <button aria-controls="controlled-datepicker-leap-year__dialog" aria-expanded="false" aria-haspopup="dialog" aria-label="Toggle Calendar Picker" class="btn calendar-button input-group-text" type="button">
              <i aria-hidden="true" class="fa-calendar-alt fas"></i>
            </button>
          </div>
        </div>
      </div>
      <div class="dropdown">
        <div aria-labelledby="controlled-datepicker-leap-year__dialog_title" aria-modal="" class="dropdown-content" id="controlled-datepicker-leap-year__dialog" role="dialog">
          <div class="sr-only" id="controlled-datepicker-leap-year__dialog_title">
            Calendar date picker
          </div>
          <div class="date-picker">
            <div aria-label="Date Picker" class="dp-single-calendar" role="region">
              <div class="calendar-inner" dir="ltr" lang="en-US" role="group">
                <header class="datepicker" title="Selected Date"><output aria-atomic="true" aria-live="polite" class="form-control form-control-sm selected-date text-center" id="selected-date" role="status" tabindex="-1"><bdi>Tuesday, February 29, 2028</bdi><bdi class="sr-only">(Selected date)</bdi></output>
                </header>
                <div aria-label="Calendar Navigation" aria-labelledby="controlled-datepicker-leap-year__navlabel" class="calendar-nav d-flex" role="group">
                  <span class="sr-only" id="controlled-datepicker-leap-year__navlabel">
                    Calendar Navigation
                  </span>
                  <button aria-keyshortcuts="Alt+PageDown" aria-label="Previous year" class="border-0 btn btn-sm dp-btn-outline-secondary flex-fill prev-year" title="Previous year" type="button">
                    <i aria-hidden="true" class="fa-angle-double-left fas"></i>
                  </button>
                  <button aria-keyshortcuts="PageDown" aria-label="Previous month" class="border-0 btn btn-sm dp-btn-outline-secondary flex-fill prev-month" title="Previous month" type="button">
                    <i aria-hidden="true" class="fa-angle-left fas"></i>
                  </button>
                  <button aria-keyshortcuts="Home" aria-label="Current Day/Month/Year" class="border-0 btn btn-sm current-date dp-btn-outline-secondary flex-fill" title="Current Day/Month/Year" type="button">
                    <i aria-hidden="true" class="fa-circle fas"></i>
                    <span class="sr-only">
                      Today
                    </span>
                  </button>
                  <button aria-keyshortcuts="PageUp" aria-label="Next month" class="border-0 btn btn-sm dp-btn-outline-secondary flex-fill next-month" title="Next month" type="button">
                    <i aria-hidden="true" class="fa-angle-right fas"></i>
