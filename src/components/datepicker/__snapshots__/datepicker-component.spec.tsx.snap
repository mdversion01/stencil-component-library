exports[`datepicker-component externally clearing a required value stays valid until blur: controlled-required-clear-after-blur 1`] = `
<datepicker-component append="" append-id="" current-month="8" current-year="2026" date-format="YYYY-MM-DD" form-layout="" icon="fas fa-calendar-alt" input-id="controlled-datepicker-required-clear" label="Date Picker" placeholder="YYYY-MM-DD" prepend-id="" required="" size="" validation="" validation-message="Please select a date." value="" warning-message="">
  <div class="date-picker">
    <div class="dropdown-wrapper">
      <div class="form-group form-input-group-basic">
        <label aria-hidden="true" class="form-control-label invalid required" for="controlled-datepicker-required-clear" id="controlled-datepicker-required-clear__label">
          <span class="required">
            Date Picker
          </span>
          <span class="required">
            *
          </span>
        </label>
        <div>
          <div class="sr-only" id="controlled-datepicker-required-clear__desc">
            Enter a date in YYYY-MM-DD format. Use the calendar button to pick a date.
          </div>
          <div aria-label="Date Picker Group" class="input-group is-invalid" role="group">
            <div class="drp-input-field">
              <input aria-describedby="controlled-datepicker-required-clear__desc controlled-datepicker-required-clear__validation" aria-invalid="true" aria-labelledby="controlled-datepicker-required-clear__label" class="form-control is-invalid" id="controlled-datepicker-required-clear" placeholder="YYYY-MM-DD" required="" type="text" value="">
            </div>
            <button aria-controls="controlled-datepicker-required-clear__dialog" aria-expanded="false" aria-haspopup="dialog" aria-label="Toggle Calendar Picker" class="btn calendar-button input-group-text is-invalid" type="button">
              <i aria-hidden="true" class="fa-calendar-alt fas"></i>
            </button>
          </div>
          <div aria-atomic="true" aria-live="polite" class="invalid-feedback validation" id="controlled-datepicker-required-clear__validation">
            Please select a date.
          </div>
