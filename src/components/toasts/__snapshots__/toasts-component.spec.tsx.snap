<toasts-component position="top-left">
  <div>
    <div aria-atomic="false" aria-label="Notifications" aria-relevant="additions text" class="toaster toaster-top-left" id="toaster-top-left" role="region">
      <div class="toaster-slot" style="max-width: 350px;">
        <div aria-atomic="true" aria-describedby="toast-component__toast_toast-test-1__body" aria-labelledby="toast-component__toast_toast-test-1__title" class="persistent show toast toast-primary toast-solid" data-toast-id="toast-test-1" id="toast-component__toast_toast-test-1__outer" role="alert">
          <div id="toast-component__toast_toast-test-1__content" tabindex="0">
            <header class="toast-header">
              <div class="align-items-center d-flex flex-grow-1">
                <svg aria-hidden="true" class="flex-shrink-0 me-2 toast-svg" focusable="false" viewBox="0 0 22 22">
                  <path d="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"></path>
