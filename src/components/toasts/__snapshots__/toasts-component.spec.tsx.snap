exports[`toasts-component renders HTML content via contentHtml and matches snapshot: standard-toast-html 1`] = `
<toasts-component position="bottom-right">
  <div>
    <div aria-atomic="false" aria-label="Notifications" aria-relevant="additions text" class="toaster toaster-bottom-right" id="toaster-bottom-right" role="region">
      <div class="toaster-slot" style="max-width: 350px;">
        <div aria-atomic="true" aria-describedby="toast-component__toast_toast-test-1__body" aria-labelledby="toast-component__toast_toast-test-1__title" class="persistent show toast toast-danger toast-solid" data-toast-id="toast-test-1" id="toast-component__toast_toast-test-1__outer" role="alert">
          <div id="toast-component__toast_toast-test-1__content" tabindex="0">
            <header class="toast-header">
              <div class="align-items-center d-flex flex-grow-1">
                <svg aria-hidden="true" class="flex-shrink-0 me-2 toast-svg" focusable="false" viewBox="0 0 22 22">
                  <path d="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"></path>
                </svg>
                <strong class="mr-auto" id="toast-component__toast_toast-test-1__title">
                  HTML Toast
                </strong>
                <small class="additional-text mr-2 text-muted">
                  1m ago
                </small>
              </div>
              <button aria-controls="toast-component__toast_toast-test-1__outer" aria-label="Close HTML Toast" class="close m1 ml-auto" id="toast-component__toast_toast-test-1__close" type="button">
                ×
              </button>
            </header>
            <div class="toast-body" id="toast-component__toast_toast-test-1__body">
              <div class="toast-body-content">
                <div class="inner">
                  <b>
                    Bold
                  </b>
                  and
                  <i>
                    italic
                  </i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</toasts-component>
`;

