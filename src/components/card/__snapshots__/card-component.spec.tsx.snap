exports[`<card-component> renders card with header and footer slots (wrapper elements always present unless noHeader/noFooter): header-and-footer-slots 1`] = `
<card-component>
  <!---->
  <article class="card" style="max-width: 20rem;">
    <div class="card-header">
      <div slot="header">
        Header Content
      </div>
    </div>
    <div class="card-body">
      <h5 class="card-title" id="card-test-title">
