// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`<card-component> applies elevation and custom classes to the article element: elevation-and-custom-class 1`] = `
<card-component class-names="custom-card" elevation="2">
  <!---->
  <article class="card custom-card elevated-2" style="max-width: 20rem;">
    <div class="card-header"></div>
    <div class="card-body">
      <h5 class="card-title" id="card-test-title">
        <div slot="title">
          Card Title
        </div>
      </h5>
      <div class="card-text">
        <div slot="text">
          Text
        </div>
      </div>
    </div>
    <div class="card-footer"></div>
  </article>
</card-component>
`;

exports[`<card-component> heading-level attribute changes the title heading tag: heading-level-2 1`] = `
